// Frequency-shift trace of two real runs, with the stability check picked out.
//
// Numbers are NOT typed in here. `traces.json` is generated by
//   python3 scripts/extract_trace.py figures/traces.json <log> <log>
// from the logs on the DATA drive, and carries its own provenance (source
// filename, pulse count, pulse voltages, sharp bounds, per-read tip verdict and
// per-read phase). The poster still builds with the drive unplugged, since the
// committed JSON is all Typst reads.
//
// Currently plotted, both from the afternoon of 2026-01-29, both +/-8 V pulses:
//   tip_prep_20260129_124032  36 pulses, 7.8 min, bounds (-6.0, 2.0)
//     check PASSED: 0.727 Hz off baseline against a 4.0 Hz tolerance
//   tip_prep_20260129_123152  35 pulses, 7.9 min, bounds (-6.0, 0.0)
//     check FAILED: 3.836 Hz off baseline against a 2.0 Hz tolerance, and the
//     loop went back to pulsing for another ten cycles
// They replaced 135558 / 115639, which reached the band but ran no stability
// check at all, so the panel could not show the `Sharp -> Stable` edge the FSM
// draws. See CLAUDE.md for what that swap cost.
//
// Each point is one `Get stable signal 76` read: 1000 points, accepted only
// once std dev and slope fall under threshold.
//
//   #import "figures/convergence.typ": convergence-plot
//   #convergence-plot(accent: accent, scale: 1.0)

#import "@preview/lilaq:0.5.0" as lq

#let traces = json("traces.json")
#let run-pass = traces.runs.at(0)
#let run-fail = traces.runs.at(1)

// The two runs' sharp windows share their lower bound and differ at the top:
// `123152` is (-6.0, 0.0) and `124032` is (-6.0, 2.0). Drawing only the shared
// part would put `124032`'s +0.43 Hz read outside a band it was actually inside,
// so the strip above 0 is drawn separately and fainter. Both are one legend
// entry, since they are one concept.
#let band-lo = calc.max(..traces.runs.map(r => r.sharp_bounds.at(0)))
#let band-shared = calc.min(..traces.runs.map(r => r.sharp_bounds.at(1)))
#let band-hi = calc.max(..traces.runs.map(r => r.sharp_bounds.at(1)))

// Defaults are sized for one column of the A0 poster (~380 mm of usable panel
// width), so `scale: 1.0` already fills a panel. Text is set near the poster
// base size rather than a chart-typical 10 pt, otherwise the axis labels are
// unreadable from two metres away.
#let convergence-plot(accent: rgb("0267A5"), scale: 1.0) = {
  set text(size: 22pt * scale)

  let fail-color = rgb("B0533A")
  let band-color = rgb("2E7D32")
  // One colour for the stability-check reads of both runs, so the check is a
  // single legend entry rather than one per run. Deliberately not green: green
  // is the band, and a *failed* check drawn in the band's colour would read as
  // a pass. Purple carries no verdict.
  let check-color = rgb("6A3D9A")

  // Faint connecting lines. Deliberately weak: they order the reads for the eye
  // without claiming a continuous trajectory (see the note on the plots below).
  let trace-line(c) = (paint: c.transparentize(72%), thickness: 2pt * scale)

  // One exclusion, applied here rather than in `traces.json`, so the extracted
  // data stays a faithful copy of the log and the reads the figure omits are
  // omitted in one visible place. `x` keeps its original read number either way,
  // so the gaps stay in the ordering.
  //
  //   `rail`: +/-76.2937 Hz is the saturation rail of the frequency-shift
  //   channel, not a measurement. It sits within 3e-4 of 5e6/2^16, a 16-bit
  //   full-scale artefact, and it recurs in both signs across the archive.
  //   `124032` contains 11 of them and `123152` 8, all with `std_dev` of
  //   exactly 0.000, which is the giveaway: a real read of this channel never
  //   has zero noise. Dropping them is what lets the axis stop at -75 instead
  //   of -80.
  //
  // The old `floor` and `deep-cut` exclusions are gone, and both had to go:
  //   - `floor` dropped |df| < 0.5 Hz as noise. That was a fact about the 2025
  //     runs, where four reads came back at 0.010 to 0.020 Hz. Here the reads
  //     near zero are -0.109, -0.115, -0.119, -0.136 and -0.275, and they are
  //     the sharpest reads in the figure. `-0.109` is the post-sweep read that
  //     decided `124032`'s check. Dropping those would delete the result.
  //   - `deep-cut` clipped the axis at -28 Hz. These runs spend most of their
  //     length between -30 and -74, so it would have removed 33 of 83 reads.
  let rail = 76.29
  let clean(ys) = {
    let keep = range(ys.len()).filter(i => {
      calc.abs(calc.abs(ys.at(i)) - rail) > 0.02
    })
    (keep, keep.map(i => ys.at(i)))
  }

  // Split a run into the pulse loop and the stability check. `phase` is written
  // by `extract_trace.py`: `loop` follows a bias pulse, `confirm` is one of the
  // repositioned reads `confirm_sharp` takes with no pulse in between, and
  // `post_sweep` is the read after the bias sweeps. The last two together are
  // the check, and they are what gets its own colour.
  let split(run, want-check) = {
    let (xs, ys) = clean(run.df)
    let keep = range(xs.len()).filter(i => {
      let is-check = run.phase.at(xs.at(i)) != "loop"
      if want-check { is-check } else { not is-check }
    })
    (keep.map(i => xs.at(i)), keep.map(i => ys.at(i)))
  }

  // Annotation for a run's post-sweep read. `x`/`y` are where the label hangs
  // from, not where the point is; `top + right` makes it extend down and left so
  // it tucks under the marker instead of over the trace.
  let post-note(run, x, y) = lq.place(
    x,
    y,
    align: top + right,
    text(size: 0.8em, fill: check-color)[
      after sweep \
      #str(calc.round(run.stability.at(0).final, digits: 2)).replace("-", "−") Hz
    ],
  )

  let (xs-pass, ys-pass) = clean(run-pass.df)
  let (xs-fail, ys-fail) = clean(run-fail.df)
  let (xs-pass-loop, ys-pass-loop) = split(run-pass, false)
  let (xs-fail-loop, ys-fail-loop) = split(run-fail, false)
  let (xs-pass-chk, ys-pass-chk) = split(run-pass, true)
  let (xs-fail-chk, ys-fail-chk) = split(run-fail, true)
  let xmax = calc.max(run-pass.df.len(), run-fail.df.len()) - 1

  lq.diagram(
    width: 350mm * scale,
    height: 118mm * scale,
    // Not "pulse cycle": the confirmation reads take no pulse, so read number
    // and pulse count part company exactly where the check starts, which is the
    // part of the figure this axis has to label honestly.
    xlabel: [$Delta f$ read],
    ylabel: [$Delta f$ (Hz)],
    xlim: (-1.5, xmax + 1.5),
    ylim: (-78, 4),
    // Both runs spend their first two thirds deep in the blunt region and only
    // the last few reads sit near zero, so the top left is the emptiest corner.
    legend: (position: top + left),

    // Sharp band drawn first so both traces sit on top of it.
    lq.fill-between(
      (-4, xmax + 4),
      (band-lo, band-lo),
      y2: (band-shared, band-shared),
      fill: band-color.transparentize(80%),
      stroke: none,
      z-index: 0,
      label: [sharp bounds],
    ),
    lq.fill-between(
      (-4, xmax + 4),
      (band-shared, band-shared),
      y2: (band-hi, band-hi),
      fill: band-color.transparentize(90%),
      stroke: none,
      z-index: 0,
    ),

    // The faint line runs over every read of a run, including the check, so the
    // ordering stays unbroken while the markers below carry the colour. Drawn
    // as its own marker-less series for exactly that reason.
    lq.plot(xs-pass, ys-pass, stroke: trace-line(accent), mark: none),
    lq.plot(xs-fail, ys-fail, stroke: trace-line(fail-color), mark: none),

    // Markers only, no connecting line of their own, on purpose. Consecutive
    // reads are taken at *different places on the sample*, since the loop
    // repositions and re-approaches between every one, so this is not a
    // continuous trajectory of one quantity. Keep the line above weak enough
    // that it reads as ordering rather than as a signal.
    lq.plot(
      xs-pass-loop, ys-pass-loop,
      stroke: none,
      mark: "o",
      mark-size: 5pt * scale,
      color: accent,
      label: [passed],
    ),
    lq.plot(
      xs-fail-loop, ys-fail-loop,
      stroke: none,
      mark: "o",
      mark-size: 5pt * scale,
      color: fail-color,
      label: [failed],
    ),

    // Both runs' check reads in one series, so the legend gains one entry
    // rather than two. They sit at different read numbers, and the faint line
    // still ties each back to its own run.
    lq.plot(
      xs-pass-chk + xs-fail-chk,
      ys-pass-chk + ys-fail-chk,
      stroke: none,
      mark: "d",
      mark-size: 7pt * scale,
      color: check-color,
      label: [stability reads],
    ),

    // The post-sweep read is the point the whole panel turns on: `check_stability`
    // compares it against the last confirmation read, and that difference is the
    // verdict. Both are drawn with the same diamond as the confirmation reads on
    // purpose: the *position* already says which run passed, one inside the band
    // and one well below it, so the annotation only has to identify the point.
    //
    // The value is read out of `traces.json` and follows the data. The anchor is
    // not: it is hand-placed into the empty region below and left of each point.
    // With the rail reads dropped, x 36-41 is clear between -6 and -30, and
    // x 26-32 is clear between -8 and -32. Re-check both if the plotted runs
    // ever change.
    post-note(run-pass, 41, -7),
    post-note(run-fail, 32, -8),
  )
}
