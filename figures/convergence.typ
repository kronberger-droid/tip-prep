// Frequency-shift convergence, plotted from real runs.
//
// Numbers are NOT typed in here any more. `traces.json` is generated by
//   python3 scripts/extract_trace.py figures/traces.json <log> <log>
// from the logs on the DATA drive, and carries its own provenance (source
// filename, pulse count, pulse voltages, sharp bounds, per-read tip verdict).
// The poster still builds with the drive unplugged, since the committed JSON is
// all Typst reads.
//
// Currently plotted, both with sharp bounds (-2.0, 0.0) Hz:
//   tip_prep_20251215_135558  34 pulses, 4.7 min  -2.0 to -6.0 V plus +3.9..+4.5
//   tip_prep_20251213_115639 287 pulses,  37 min  +/-4, +/-5, +/-6 V
// Both exit only after FOUR consecutive in-band reads, with a repositioning
// between each. The 9-pulse run 151951 that used to sit here exited on its first
// in-band read, so the pair no longer mixes two different exit criteria.
// Each point is one `Get stable signal 76` read: 1000 points, accepted only
// once std dev and slope fall under threshold.
//
//   #import "figures/convergence.typ": convergence-plot
//   #convergence-plot(accent: accent, scale: 1.0)

#import "@preview/lilaq:0.5.0" as lq

#let traces = json("traces.json")
#let run-short = traces.runs.at(0)
#let run-long = traces.runs.at(1)

// Sharp band from the run config: a shift inside this window counts as sharp.
// Both plotted runs used the same window, which is why they can share an axis.
#let sharp-band = run-long.at("sharp_bounds")

// Defaults are sized for one column of the A0 poster (~380 mm of usable panel
// width), so `scale: 1.0` already fills a panel. Text is set near the poster
// base size rather than a chart-typical 10 pt, otherwise the axis labels are
// unreadable from two metres away.
#let convergence-plot(accent: rgb("0267A5"), scale: 1.0) = {
  set text(size: 22pt * scale)

  let short-color = rgb("B0533A")
  let band-color = rgb("2E7D32")

  // Two exclusions, both applied here rather than in `traces.json`, so the
  // extracted data stays a faithful copy of the log and every read the figure
  // omits is omitted in one visible place. `x` keeps its original cycle number
  // either way, so the gaps stay in the ordering.
  //
  //  1. `floor`: reads at the noise floor. Four reads in `115639` come back at
  //     0.010 to 0.020 Hz while the next smallest magnitude anywhere in either
  //     run is 1.559 Hz, a factor of ~78. Nothing real is near 0.5, so this
  //     cutoff is a fact about the data rather than a preference. These four are
  //     also the reads the loop's own confirmation step rejected.
  //
  //  2. `deep-cut`: the two isolated far-out reads, -37.5 Hz at cycle 13 and
  //     -42.4 Hz at cycle 221. Unlike the noise-floor four, **these look like
  //     real measurements of a very blunt apex.** They are dropped for
  //     readability only: they forced the axis to -45 and squeezed 90% of the
  //     reads into 36% of its height. After the cut the axis is -28 and the
  //     lowest surviving read is -26.09 Hz, so nothing is hidden just off-frame.
  //     If the exclusion ever needs defending, either put them back and clip the
  //     axis with off-scale markers, or state "2 of 291 reads below -28 Hz
  //     omitted" in the caption.
  //  3. `rail`: ±76.2937 Hz is the saturation rail of the frequency-shift
  //     channel, not a measurement (it sits within 3e-4 of 5e6/2^16, a 16-bit
  //     full-scale artefact) and it recurs in both signs across the archive.
  //     `135558` contains one, at cycle 21. `ylim` would hide it anyway, but a
  //     clipped sample should be dropped on principle, not by luck of framing.
  let floor = 0.5
  let deep-cut = -28
  let rail = 76.29
  let clean(ys) = {
    let keep = range(ys.len()).filter(i => {
      let v = ys.at(i)
      calc.abs(v) >= floor and v >= deep-cut and calc.abs(calc.abs(v) - rail) > 0.02
    })
    (keep, keep.map(i => ys.at(i)))
  }

  let (xs-long, ys-long) = clean(run-long.df)
  let (xs-short, ys-short) = clean(run-short.df)
  let xmax = run-long.df.len() - 1

  lq.diagram(
    width: 300mm * scale,
    height: 120mm * scale,
    xlabel: [pulse cycle],
    ylabel: [$Delta f$ (Hz)],
    xlim: (-4, xmax + 4),
    ylim: (deep-cut, 2.5),
    // Bottom right is the emptiest corner once the far-out reads are gone: the
    // last read below -20 Hz is cycle 222, so everything past ~230 is clear.
    legend: (position: bottom + right),

    // Sharp band drawn first so both traces sit on top of it.
    lq.fill-between(
      (-10, xmax + 10),
      (sharp-band.at(0), sharp-band.at(0)),
      y2: (sharp-band.at(1), sharp-band.at(1)),
      fill: band-color.transparentize(80%),
      stroke: none,
      z-index: 0,
      label: [sharp bounds],
    ),

    // Markers only, no connecting line, on purpose. Consecutive reads are taken
    // at *different places on the sample*: the loop repositions and re-approaches
    // between every one. A line would draw a continuous trajectory of a single
    // quantity, which is not what happened. These are independent samples of the
    // apex, ordered by cycle. Do not "fix" this by joining them up.
    lq.plot(
      xs-long, ys-long,
      stroke: none,
      mark: "o",
      mark-size: 6pt * scale,
      color: accent,
      label: [287 pulses, 37 min],
    ),
    lq.plot(
      xs-short, ys-short,
      stroke: none,
      mark: "s",
      mark-size: 7pt * scale,
      color: short-color,
      label: [34 pulses, 4.7 min],
    ),
  )
}
